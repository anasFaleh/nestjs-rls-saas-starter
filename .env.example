# Copy to .env and change the passwords.

# HTTP port
PORT=3000
# Number of reverse proxies in front of the app (0 = none, 1 = behind Caddy/Nginx). Sets Express "trust proxy".
TRUST_PROXY_HOPS=0

# OWNER connection: Prisma migrations, `npm run db:roles`, the tenant CLI and test seeding. Never used by the running API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/saas_starter

# RUNTIME connection: the API connects as this non-owner role, so Row Level Security always applies.
# `npm run db:roles` creates/updates the role with the user name and password written here.
APP_DATABASE_URL=postgresql://app_user:change-me-app-password@localhost:5434/saas_starter
